# Conexión a PostgreSQL (Supabase → Project Settings → Database → Connection string, URI)
DATABASE_URL=postgresql://postgres:CONTRASEÑA@HOST:5432/postgres
DB_SSL=true

# Autenticación
JWT_SECRETO=cambia-esto-por-una-cadena-larga-y-aleatoria
JWT_DURACION=8h

# Puerto del servidor (Render/Railway lo rellenan solos)
PORT=3000

# Clave para cifrar las contraseñas SMTP de los centros. Una cadena larga
# y aleatoria. Si se cambia, habrá que volver a escribir esas contraseñas.
CLAVE_CIFRADO=cambia-esto-por-otra-cadena-larga-y-aleatoria
